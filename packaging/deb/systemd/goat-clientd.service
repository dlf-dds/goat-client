[Unit]
Description=goat-client tunnel daemon
Documentation=https://github.com/dlf-dds/goat-client
After=network-online.target
Wants=network-online.target

# Type=simple — the Go daemon does not call sd_notify(3) (it would need
# a libsystemd binding we have not vendored). Type=notify made systemd
# wait for a READY=1 that never arrives, then kill the unit. simple is
# the match for "daemon stays in the foreground; ready as soon as up."
[Service]
Type=simple
EnvironmentFile=-/etc/default/goat-client
# goat-clientd registers -bundle / -socket / -trust-roots / -config; it
# has NO -bundle-dir / -ipc-socket / -log-file. Go's flag package exits 2
# on the first unknown flag, which crash-looped this unit. Logs go to
# stdout/stderr, captured by the journal (see LogsDirectory below).
ExecStart=/usr/bin/goat-clientd \
    --bundle=/var/lib/goat-client/bundle.cbor \
    --socket=/run/goat-client/ipc.sock \
    --trust-roots=/etc/goat-client/trust-roots.pem \
    --config=/etc/goat-client/config.toml \
    $GOAT_CLIENTD_FLAGS
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# Drops privileges after binding the WG iface (CAP_NET_ADMIN required;
# everything else is removed). System user `goat-client` is created
# by the deb postinst.
User=goat-client
Group=goat-client
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

# systemd-managed dirs. RuntimeDirectory cleared on stop; State/Cache/
# Logs persist across restarts. Mode 0750 so only root + the service
# user can read tunnel state / bundle.
ConfigurationDirectory=goat-client
ConfigurationDirectoryMode=0750
StateDirectory=goat-client
# 0755 so goat-cli (any local user) can traverse into names/ — the
# shared name store (verify-at-read; nothing secret at dir level).
# Secrets keep their own file modes (bundle.cbor 0600, profiles/ 0700).
StateDirectoryMode=0755
CacheDirectory=goat-client
CacheDirectoryMode=0750
LogsDirectory=goat-client
LogsDirectoryMode=0750
RuntimeDirectory=goat-client
RuntimeDirectoryMode=0755

# Sandbox — modeled on netbird@.service, tightened where we can since
# we never need to load the wg kernel module from this unit (we expect
# the operator's distro to ship it; if not, we fall back to userspace
# wireguard-go which lives entirely in our binary).
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateMounts=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
