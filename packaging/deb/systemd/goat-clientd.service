[Unit]
Description=goat-client tunnel daemon
Documentation=https://github.com/dlf-dds/goat-client
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=-/etc/default/goat-client
ExecStart=/usr/bin/goat-clientd \
    --bundle-dir=/var/lib/goat-client \
    --ipc-socket=/run/goat-client/ipc.sock \
    --log-file=/var/log/goat-client/goat-clientd.log \
    --config=/etc/goat-client/config.toml \
    $GOAT_CLIENTD_FLAGS
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# Drops privileges after binding the WG iface (CAP_NET_ADMIN required;
# everything else is removed). System user `goat-client` is created
# by the deb postinst.
User=goat-client
Group=goat-client
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

# systemd-managed dirs. RuntimeDirectory cleared on stop; State/Cache/
# Logs persist across restarts. Mode 0750 so only root + the service
# user can read tunnel state / bundle.
ConfigurationDirectory=goat-client
ConfigurationDirectoryMode=0750
StateDirectory=goat-client
StateDirectoryMode=0750
CacheDirectory=goat-client
CacheDirectoryMode=0750
LogsDirectory=goat-client
LogsDirectoryMode=0750
RuntimeDirectory=goat-client
RuntimeDirectoryMode=0755

# Sandbox — modeled on netbird@.service, tightened where we can since
# we never need to load the wg kernel module from this unit (we expect
# the operator's distro to ship it; if not, we fall back to userspace
# wireguard-go which lives entirely in our binary).
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateMounts=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
