# /etc/sysconfig/goat-client — env file for the goat-clientd systemd unit.
# Marked %config(noreplace) by nfpm, so operator edits survive upgrades.

# Extra flags appended to the daemon command line.
# Examples:
#   --log-level=debug
#   --userspace-wg
#   --mode=combined         # override /etc/goat-client/config.toml at runtime
GOAT_CLIENTD_FLAGS=

# v0.2 mode selector. Read by the rpm %post script when (re)writing
# /etc/goat-client/config.toml on install. Empty value means
# "use the daemon's default" (combined). Operators can edit this file
# and reinstall the package to re-apply, or just use
# `goat-client setmode <mode>` at runtime.
#
# Valid values: wg-cp0-only | netbird-only | combined
GOAT_MODE=
