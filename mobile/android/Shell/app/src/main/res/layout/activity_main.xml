<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- wg-cp0 outer tunnel status card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/wgCp0Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <View
                    android:id="@+id/wgCp0Dot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@android:drawable/presence_invisible"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:text="@string/card_wgcp0_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?android:attr/textColorSecondary"
                        android:text="@string/card_wgcp0_subtitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/wgCp0State"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:fontFamily="monospace"
                    android:textColor="?android:attr/textColorSecondary"
                    android:text="@string/state_idle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Inner-mesh tunnel status card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/innerMeshCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <View
                    android:id="@+id/innerMeshDot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@android:drawable/presence_invisible"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:text="@string/card_innermesh_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?android:attr/textColorSecondary"
                        android:text="@string/card_innermesh_subtitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/innerMeshState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:fontFamily="monospace"
                    android:textColor="?android:attr/textColorSecondary"
                    android:text="@string/state_idle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Aggregate / fallback status text — kept from v0.1.x for
             continuity. Mostly shows mode-specific info now. -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:text="@string/status_unconfigured" />

        <TextView
            android:id="@+id/detailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Mode-selector group. Visibility toggled by MainActivity
             based on bundle capabilities. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:text="@string/section_mode" />

        <TextView
            android:id="@+id/modeSingle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="visible" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/modeWgCp0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_wgcp0_only" />

            <RadioButton
                android:id="@+id/modeNetbird"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_netbird_only" />

            <RadioButton
                android:id="@+id/modeCombined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_combined" />
        </RadioGroup>

        <TextView
            android:id="@+id/modeBlurb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importBundleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/import_bundle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/connect"
            android:enabled="false" />
    </LinearLayout>
</ScrollView>
